# Local dev store settings. Copy to dev/.env (git-ignored) and fill in.
# NEVER commit real tokens — dev/.env is excluded via .gitignore.

# Tradeaze API mode: 'test' = staging API (https://stage-api.tradeaze.app),
# 'live' = production API. Local development should use 'test'.
TRADEAZE_API_MODE=test

# Your Tradeaze staging API token. Ask the Tradeaze team for a staging
# token; leave empty to install the store without an active integration.
TRADEAZE_API_TOKEN=

# --- Optional overrides (defaults shown) ------------------------------------
#MAGENTO_VERSION=2.4.8
#ADMIN_USER=admin
#ADMIN_PASSWORD=Admin123!
#ADMIN_EMAIL=admin@example.com
