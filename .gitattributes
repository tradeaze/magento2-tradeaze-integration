# Exclude development-only files from Composer dist archives.
# Merchants installing this package via Composer get a clean vendor
# directory containing only what the module needs at runtime.
/.ddev          export-ignore
/.github        export-ignore
/dev            export-ignore
/docs           export-ignore
/src/Test       export-ignore
/.gitattributes export-ignore
/.gitignore     export-ignore
/phpcs.xml      export-ignore
